---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "my page",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi, I’m pointvoid, I am just a very curious person and this page is a way of showing the world things i 
			am curious about, the projects i am working on and my current personal syllabus i sm studying. I also try to 
			write in <a
				class="cactus-link inline-block"
				href="https://pointvoid.substack.com/"
				rel="noreferrer"
				target="_blank">Substack</a
			>
		</p>
		
		<p>
			Here is my <a
				class="cactus-link inline-block"
				href="https://github.com/pointvoid"
				rel="noreferrer"
				target="_blank">GitHub</a
			> for you to checkout.
		</p>
	</div>
</PageLayout>
